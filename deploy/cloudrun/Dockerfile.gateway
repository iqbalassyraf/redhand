# AgentWall (the MCP gateway) for Google Cloud Run.
# Build from the repository root:  docker build -f deploy/cloudrun/Dockerfile.gateway .
FROM python:3.13-slim AS build
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN pip install --no-cache-dir uv==0.11.32
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY services/redhand-core ./services/redhand-core
COPY packages ./packages
COPY agentwall ./agentwall
RUN uv sync --frozen --no-dev --package agentwall --no-install-project

FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/venv/bin:$PATH
RUN useradd --system --uid 10001 --no-create-home app
COPY --from=build /opt/venv /opt/venv
# AgentWall uses package-relative imports, so it runs as `agentwall.src.main` from /app.
COPY agentwall /app/agentwall
WORKDIR /app
USER app
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn agentwall.src.main:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers"]
