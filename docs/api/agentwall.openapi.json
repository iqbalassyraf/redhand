                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Metrics"
      }
    },
    "/v1/mcp/vet": {
      "post": {
        "description": "Static vetting of an MCP manifest supplied in the body. Fetches nothing.",
        "operationId": "vet_mcp_manifest_v1_mcp_vet_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MCPVettingReport"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Vet Mcp Manifest"
      }
    },
    "/v1/policies": {
      "get": {
        "operationId": "get_policies_v1_policies_get",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Policies V1 Policies Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Policies"
      }
    }
  }
