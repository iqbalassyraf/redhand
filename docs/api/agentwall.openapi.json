{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MCPFinding": {
        "properties": {
          "category": {
            "enum": [
              "EXECUTION_RISK",
              "CREDENTIAL_EXPOSURE",
              "FILESYSTEM_RISK",
              "SCHEMA_RISK",
              "NETWORK_RISK",
              "DESCRIPTION_RISK"
            ],
            "title": "Category",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "remediation": {
            "title": "Remediation",
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ],
            "title": "Severity",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          }
        },
        "required": [
          "id",
          "severity",
          "category",
          "title",
          "description",
          "remediation"
        ],
        "title": "MCPFinding",
        "type": "object"
      },
      "MCPVettingReport": {
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/MCPFinding"
            },
            "title": "Findings",
            "type": "array"
          },
          "recommended_policy": {
            "additionalProperties": true,
            "title": "Recommended Policy",
            "type": "object"
          },
          "risk_score": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Risk Score",
            "type": "integer"
          },
          "server_name": {
            "title": "Server Name",
            "type": "string"
          },
          "total_tools_scanned": {
            "title": "Total Tools Scanned",
            "type": "integer"
          },
          "verdict": {
            "enum": [
              "PASS",
              "WARN",
              "FAIL"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "server_name",
          "risk_score",
          "verdict",
          "total_tools_scanned"
        ],
        "title": "MCPVettingReport",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Enforces Agent Passports on MCP tool traffic.",
    "title": "AgentWall: RedHand MCP Gateway",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthz_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Healthz Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/mcp/{server}": {
      "get": {
        "description": "Server-initiated SSE streams are not offered in Phase 1 (allowed by the MCP spec).",
        "operationId": "mcp_gateway_stream_mcp__server__get",
        "parameters": [
          {
            "in": "path",
            "name": "server",
            "required": true,
            "schema": {
              "title": "Server",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mcp Gateway Stream"
      },
      "post": {
        "description": "MCP Streamable HTTP endpoint for one registered server. The agent authenticates with\nits RedHand access token. If the upstream MCP server needs its own credential, the\nagent supplies it in `X-RedHand-Upstream-Authorization`; it is forwarded as\n`Authorization` and never logged. (Brokering upstream credentials is Phase 1.5.)",
        "operationId": "mcp_gateway_mcp__server__post",
        "parameters": [
          {
            "in": "path",
            "name": "server",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "title": "Server",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "X-RedHand-Upstream-Authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Redhand-Upstream-Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mcp Gateway"
      }
    },
