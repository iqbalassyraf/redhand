# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# RedHand Core (FastAPI on GCP Cloud Run)
REDHAND_CORE_URL=http://localhost:8000
REDHAND_API_KEY=rh_live_example_key_12345
GOOGLE_APPLICATION_CREDENTIALS=/path/to/broker-service-account.json

# RedHand SDK Local Firewall
REDHAND_ONNX_MODEL_PATH=~/.cache/redhand/deberta-v3-prompt-injection-int8.onnx


# RedHand Core: operator authentication and integrations
# ENVIRONMENT: development | test | staging | production. The in-memory dev store and
# the /v1/dev/login endpoint only work in development, without SUPABASE_URL configured.
ENVIRONMENT=development
# Operator login verification. Staging and production: the JWKS pair (a Supabase project with
# asymmetric JWT signing keys). The shared secret below is for local development and tests ONLY:
# core refuses to start with it when ENVIRONMENT is staging or production.
OPERATOR_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
OPERATOR_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# OPERATOR_JWT_SECRET=<local development and tests only; never in staging or production>
# How many proxies core runs behind (Cloud Run: 1; the deploy script sets it). 0 ignores X-Forwarded-For.
# TRUSTED_PROXY_HOPS=0
# Slack HITL approvals (optional; endpoint is disabled unless both are set)
SLACK_SIGNING_SECRET=
SLACK_ORGANIZATION_ID=
# SCIM 2.0 (enterprise tier; disabled unless set)
SCIM_BEARER_TOKEN=
# Agent passports: Ed25519 private key (PEM, PKCS8) that signs agent access tokens.
# Generate: openssl genpkey -algorithm ed25519
AGENT_TOKEN_SIGNING_KEY=
AGENT_TOKEN_TTL_SECONDS=600
# Shared secret AgentWall presents to redhand-core's /internal API (set the same value as
# AGENTWALL_CORE_SERVICE_TOKEN). Generate: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=
# Development only: allow http:// and localhost MCP server URLs
ALLOW_INSECURE_MCP_URLS=false
# Telegram panic command (optional; unset disables it). Bot token from @BotFather; the webhook
# secret is 32-256 characters of letters, digits, _ or - (generate: openssl rand -hex 32).
# See docs/runbooks/telegram-panic-command.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# AgentWall (MCP gateway)
AGENTWALL_ENVIRONMENT=development
AGENTWALL_CORE_URL=http://localhost:8000
# Must equal INTERNAL_SERVICE_TOKEN above; without it the gateway denies every call.
AGENTWALL_CORE_SERVICE_TOKEN=
# Optional: Ed25519 public key (PEM) for agent tokens; otherwise fetched from core's JWKS.
AGENTWALL_AGENT_TOKEN_PUBLIC_KEY=
AGENTWALL_CONTEXT_CACHE_TTL_SECONDS=2
# Budget Guard: how often call counts are reported to core (seconds), and the most (agent, day)
# counters kept in memory. A limited agent that cannot be tracked is refused.
AGENTWALL_BUDGET_FLUSH_INTERVAL_SECONDS=5
AGENTWALL_BUDGET_MAX_TRACKED_KEYS=100000
# Development only: allow http:// and private-network MCP servers.
AGENTWALL_ALLOW_INSECURE_UPSTREAMS=false
# How many proxies the gateway runs behind (Cloud Run: 1; the deploy script sets it). 0 ignores X-Forwarded-For.
# AGENTWALL_TRUSTED_PROXY_HOPS=0
# Append-only JSON-lines copy of gateway decisions (recommended outside development).
AGENTWALL_AUDIT_LOG_FILE=./agentwall-audit.jsonl
